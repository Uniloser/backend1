PORT=3000
HOST=0.0.0.0
FRONTEND_URL=http://localhost:8082
# Browser origins allowed to call the API. Include the production web origin(s).
CORS_ORIGINS=http://localhost:8082,http://localhost:3002,http://127.0.0.1:8082,http://127.0.0.1:3002
# Set to the number of trusted reverse-proxy hops in production; keep 0 locally.
TRUST_PROXY_HOPS=0
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Required by the local ADMIN payout console; UUID of a Supabase Auth user
# whose app_metadata.role is "admin". Never pass this value from a browser.
PAYOUT_ADMIN_USER_ID=
# Or use the newer secret key name instead of SUPABASE_SERVICE_ROLE_KEY:
# SUPABASE_SECRET_KEY=your_supabase_secret_key
# Set the same random bearer token in RevenueCat's webhook configuration.
REVENUECAT_WEBHOOK_AUTH_TOKEN=replace_with_a_long_random_secret
# Generate with: npx web-push generate-vapid-keys
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:support@readagora.com
REDIS_URL=
SUPABASE_COVER_BUCKET=covers
SUPABASE_AVATAR_BUCKET=avatars
